{
  "schema_version": "order-phase4-template.v1",
  "template_id": "pickup_ready_notification.v1",
  "profile_id": "pickup_ready_notification",
  "template_version": "v1",
  "enabled": true,
  "match": {
    "vendor_identity": "dutchie"
  },
  "extract": {
    "order_number": {
      "method": "regex",
      "pattern": "order\\s*#\\s*([0-9-]+)",
      "transforms": ["trim", "normalize_order_number"]
    },
    "status": {
      "method": "line_contains",
      "value": "ready for pickup",
      "transforms": ["trim", "collapse_spaces"]
    }
  },
  "required_fields": ["order_number", "status"],
  "confidence_rules": {
    "high_requires": ["order_number", "status"]
  },
  "post_process": {}
}
